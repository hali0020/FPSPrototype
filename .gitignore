/Content/Developers/
/Content/Collections/
/Config/DefaultEditorPerProjectUserSettings.ini

# Plugin build products (keep plugin source and content)
/Plugins/*/Binaries/
/Plugins/*/Intermediate/
/Plugins/*/Saved/

# Operating-system files
.DS_Store
Thumbs.db
Desktop.ini
