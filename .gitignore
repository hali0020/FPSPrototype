# Unreal Engine generated folders
/Binaries/
/DerivedDataCache/
/Intermediate/
/Saved/
/.vs/

# Generated build-order logs
/Build/*/FileOpenOrder/

# IDE and generated project files
*.sln
*.slnx
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
*.xcodeproj
*.xcworkspace
/.idea/
/.vscode/
/.vsconfig
*.code-workspace

# Per-user Unreal content
/Content/Developers/
/Content/Collections/
/Config/DefaultEditorPerProjectUserSettings.ini

# Licensed Marketplace source assets: re-download with the licensed Fab account.
# Never push raw or UE5-resaved FPS Weapon Bundle packages, even to a private repo.
/Content/FPS_Weapon_Bundle/

# Licensed Fab audio used only by the local development/packaged build.
# Public source clones intentionally omit these source-format SoundWave assets.
/Content/HumanVocalizations/
/Content/InterfaceAndItemSounds/

# Local recovery data used while rewriting public Git history.
/.local-licensed-assets/

# Plugin build products (keep plugin source and content)
/Plugins/*/Binaries/
/Plugins/*/Intermediate/
/Plugins/*/Saved/

# Operating-system files
.DS_Store
Thumbs.db
Desktop.ini
